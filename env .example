# Copia este archivo como .env.local para probar en local (nunca lo subas a GitHub)

# Obligatoria: tu clave de la API de Google Gemini (gratis en aistudio.google.com/app/apikey)
Gemini_API_Key=

# Opcional: si la defines, la web pedirá este código antes de dejar usarla.
# Recomendable si la vas a compartir públicamente, para controlar quién la usa
# y no gastar tu cuota diaria gratuita de Gemini.
APP_PASSWORD=elige-un-codigo
